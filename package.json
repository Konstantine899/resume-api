{
  "name": "resume-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend API for personal portfolio (NestJS + Prisma + PostgreSQL)",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.mts",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "validate": "npm run type-check && npm run lint && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "^1.16.20",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.9",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  }
}

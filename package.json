{
  "name": "resume-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend API for personal portfolio (NestJS + Prisma + PostgreSQL)",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "validate": "npm run type-check && npm run lint && npm run test",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,cts,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}

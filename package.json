{
  "name": "resume-api",
  "private": true,
  "version": "0.1.0",
  "description": "Backend API for personal portfolio (NestJS + Prisma + PostgreSQL)",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed:admin": "npm run build && node dist/modules/auth/presentation/cli/seed-admin.js",
    "prisma:generate": "prisma generate",
    "validate": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run test:e2e && npm run build",
    "prepare": "husky",
    "dev:db": "docker compose up -d db",
    "migrate:dev": "prisma migrate dev",
    "predev:api": "npm run type-check && npm run build",
    "dev:api": "cross-env NODE_ENV=development node dist/main.js",
    "dev": "concurrently -n db,api --kill-others-on-fail \"npm run dev:db\" \"npm run dev:api\"",
    "prod:db": "docker compose up -d db",
    "preprod:api": "npm run type-check && npm run build",
    "prod:api": "cross-env NODE_ENV=production node dist/main.js",
    "prod": "concurrently -n db,api --kill-others-on-fail \"npm run prod:db\" \"npm run prod:api\"",
    "dev:stop": "docker compose down",
    "migrate:media:paths": "npm run build && node dist/modules/media/presentation/cli/migrate-document-image-paths.js",
    "backfill:media:variants": "npm run build && node dist/modules/media/presentation/cli/backfill-media-variants.js"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.4",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "supertest": "^7.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}

# Server
PORT=3000
NODE_ENV=development

# Database (docker compose service `db`, see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_api

# JWT
# Min 32 bytes of entropy, otherwise the app refuses to start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Swagger UI: served at /docs and /openapi.json only when enabled AND
# NODE_ENV != production.
SWAGGER_ENABLED=false

# Admin seed (`npm run seed:admin`) — the ONLY way to create a user:
# there is deliberately no public registration endpoint. Password >= 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS allowlist: exactly the frontend origin, with credentials.
FRONTEND_ORIGIN=http://localhost:5173

# Refresh-cookie Path: '/auth' covers /auth/refresh + /auth/logout.
# Behind the vite '/api' proxy set '/api/auth' (the browser matches the
# cookie path against the URL it requested, before proxying).
COOKIE_PATH=/auth

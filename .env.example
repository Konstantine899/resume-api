# Server
PORT=3000

# Database (local docker-compose Postgres appears in Step 2 of the plan)
DATABASE_URL=postgresql://user:pass@localhost:5432/resume_api?schema=public

# JWT (generate with `openssl rand -base64 48`, min 32 chars)
JWT_ACCESS_SECRET=changeme-min-32-chars
JWT_REFRESH_SECRET=changeme-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

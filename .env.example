# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Swagger (/docs) — available only when SWAGGER_ENABLED=true AND NODE_ENV != production
SWAGGER_ENABLED=true

# Database (docker-compose: `npm run db:up` → dev on 5432, test on 5433)
DATABASE_URL=postgresql://resume:resume@localhost:5432/resume_api?schema=public

# JWT (generate with `openssl rand -base64 48`; min 32 chars AND >= 3.0 bits/char Shannon entropy)
JWT_ACCESS_SECRET=changeme-min-32-chars
JWT_REFRESH_SECRET=changeme-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

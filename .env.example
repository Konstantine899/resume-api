# Server
PORT=3000
NODE_ENV=development

# Database (docker compose service `db`, see docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_api

# JWT
# Min 32 bytes of entropy, otherwise the app refuses to start.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Swagger UI: served at /docs and /openapi.json only when enabled AND
# NODE_ENV != production.
SWAGGER_ENABLED=false

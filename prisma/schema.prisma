// Prisma schema for resume-api.
// Step 3 (auth): User + RefreshSession. RefreshSession stores ONLY the
// SHA-256 hash of the refresh token — the raw token is never persisted.
// Prisma 7 no longer carries the datasource URL here: it lives in prisma7.config.ts.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

/// Single-user personal site: the only possible role is `admin`.
enum Role {
  ADMIN
}

/// Refresh-session lifecycle: active -> used (rotation) / revoked (reuse,
/// logout, replaced, expired); revoked is terminal.
enum SessionState {
  active
  used
  revoked
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  /// PHC string of the argon2id hash; OWASP params (m=19456,t=2,p=1) are
  /// embedded next to the hash, inside the same string.
  passwordHash String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())

  sessions RefreshSession[]
}

model RefreshSession {
  id        String       @id @default(uuid())
  familyId  String
  userId    String
  deviceId  String
  /// SHA-256 hex of the refresh token; the raw token exists only in flight.
  tokenHash String       @unique
  status    SessionState @default(active)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  usedAt    DateTime?
  revokedAt DateTime?
  /// reuse | logout | replaced | expired
  revokedReason String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([familyId, status])
  @@index([userId, deviceId])
}

// Content aggregates (Step 4). Localized strings are stored as
// LocalizedText JSON objects ({ en, ru }) to keep the read model simple.

model AboutContent {
  id           String   @id @default("singleton")
  fullName     String
  descriptions Json
  stats        Json
  statLabels   Json?
  ctaLabel     Json?
  portrait     String?
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model ContactContent {
  id          String   @id @default("singleton")
  email       String
  texts       Json
  formTexts   Json
  socialLinks Json
  updatedAt   DateTime @updatedAt

  @@index([updatedAt])
}

model Project {
  id          String    @id @default(uuid())
  title       String
  description Json
  techIcons   Json
  link        String?
  image       String    @default("")
  category    String?
  status      String?
  featured    Boolean   @default(false)
  role        Json?
  metrics     Json?
  year        Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([featured])
  @@index([createdAt])
  @@index([updatedAt])
}

model SkillCategory {
  id             String  @id @default(uuid())
  category       String  @unique
  categoryName   String
  technologies   Json
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model Job {
  id             String    @id @default(uuid())
  company        String
  position       Json
  period         String
  startDate      DateTime
  endDate        DateTime?
  description    Json
  technologies   Json
  location       String
  current        Boolean   @default(false)
  employmentType String
  level          String
  companyUrl     String?
  featured       Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([current])
  @@index([startDate])
  @@index([featured])
  @@index([updatedAt])
}

model Technology {
  key           String   @id
  url           String
  invertInDark  Boolean?
  updatedAt     DateTime @updatedAt

  @@index([updatedAt])
}

model SiteSettings {
  id        String   @id @default("singleton")
  resumeUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}
